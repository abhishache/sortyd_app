    "This list powers widgets and analytics until you make another one active.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه القائمة تظهر في الويدجت والتحليلات إلى أن تختار قائمة أخرى كنشطة."
          }
        },
