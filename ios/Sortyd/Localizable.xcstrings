    },
    "This permanently deletes all completion snapshots and streaks. Your lists and tasks are not affected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع لقطات الإنجاز والسلاسل بشكل دائم. لن تتأثر قوائمك ومهامك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todas las capturas de cumplimiento y rachas. Tus listas y tareas no se ven afectadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会永久删除所有完成快照和连续记录，但不会影响列表和任务。"
          }
        }
      }
    },
