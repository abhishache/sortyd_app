    "Esto borra permanentemente todas las capturas y rachas. Tus listas y tareas no se verán afectadas.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع لقطات الإكمال والنشاطات بشكل دائم. لن تتأثر قوائمك ومهامك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra permanentemente todas las capturas y rachas. Tus listas y tareas no se verán afectadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会永久删除所有完成快照和连续记录，但不会影响列表和任务。"
          }
        }
      }
    },
    "Every honest review helps Sortyd surface to the right people. It takes two minutes and means a lot to us.": {
      "comment": "A body paragraph of text that describes the benefits of leaving a review.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تقييم صادق يساعد Sortyd في الوصول إلى الأشخاص المناسبين. يستغرق الأمر دقيقتين ويعني الكثير لنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada reseña honesta ayuda a Sortyd a llegar a las personas adecuadas. Solo toma dos minutos y significa mucho para nosotros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一条真诚评价都能帮助 Sortyd 被合适的人发现。只需两分钟，对我们意义很大。"
          }
        }
      }
    },
