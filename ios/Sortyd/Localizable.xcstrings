    "%@s are %lld%% stronger than %@s": {
      "comment": "A description of the performance of the best weekday compared to the worst weekday. The first argument is the string “Sun”, the string “Mon”, the string “Tue”, the string “Wed”, the string “Thu”, the string “Fri” or the string “Sat”. The second argument is the name of the worst weekday. The third argument is the string “Sun”, the string “Mon”, the string “Tue”, the string “Wed”, the string “Thu”, the string “Fri” or the string “Sat”.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@s أقوى بنسبة %2$lld%% من %3$@s"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@s are %2$lld%% stronger than %3$@s"
          }
        },
        "es": {
