<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ── Launch screen ── -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- ── HealthKit ── -->
    <!-- FIX: was two <string> tags under one key (invalid plist, parser crash).
         Merged into a single string. App only reads — no write permission requested. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Sortyd reads your daily step count and active calories from Health to automatically track progress on your health tasks. No health data is written or shared.</string>

    <!-- ── URL scheme — required for sortyd:// widget deep links ── -->
    <!-- FIX: CFBundleURLTypes was missing entirely. Without this the OS does not
         route sortyd:// URLs to Sortyd, so widget taps silently dropped into the
         wrong tab. The onOpenURL handler in SortydApp.swift now receives them. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.sortyd.sortyd</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>sortyd</string>
            </array>
        </dict>
    </array>

    <!-- ── Notifications ── -->
    <!-- NOTE: iOS does not require a usage description key for notifications
         (permission is requested via UNUserNotificationCenter at runtime),
         but adding a short reason here matches App Store Connect metadata. -->

    <!-- ── Export compliance ── -->
    <!-- CryptoKit is used only for HMAC-SHA256 request signing (authentication),
         not for encrypting user data. Exempt from EAR non-exempt encryption. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

</dict>
</plist>
